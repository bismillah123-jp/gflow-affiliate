# Env contoh — copy ke config.env lalu sesuaikan (opsional, semua ada default).
# Dipakai via:  set -a; source config.env; set +a

# Nama Flow project untuk gflow (opsional; kosongkan = project default Flow)
GFLOW_PROJECT=

# Model video gflow (default: Omni Flash). Alternatif: "Veo 3.1 - Fast"
GFLOW_VIDEO_MODEL=Omni Flash

# Suara voice-over Bahasa Indonesia (default: id-ID-GadisNeural)
# Alternatif: id-ID-ArdiNeural
AFFILIATE_VOICE=id-ID-GadisNeural

# Path Chrome bila tidak di lokasi standar
# GFLOW_CHROME_PATH=/usr/bin/google-chrome

# 1 = semua panggilan gflow/API dipalsukan (untuk testing)
# AFFILIATE_DRY_RUN=1
